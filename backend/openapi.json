  "components": {
    "schemas": {
      "AnswerView": {
        "properties": {
          "question_key": {
            "type": "string",
            "title": "Question Key"
          },
          "type": {
            "$ref": "#/components/schemas/QuestionType"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "display_value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Value"
          },
          "skipped": {
            "type": "boolean",
            "title": "Skipped"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question_key",
          "type",
          "title",
          "value",
          "display_value",
          "skipped"
        ],
        "title": "AnswerView"
      },
      "CreateForm": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "title": "Title",
            "default": "Untitled form"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CreateForm"
      },
      "DistributionItem": {
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              }
            ],
            "title": "Value"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "percentage": {
            "type": "number",
            "title": "Percentage"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "value",
          "label",
          "count",
          "percentage"
        ],
        "title": "DistributionItem"
      },
      "DraftDefinition": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "title": "Title"
          },
          "questions": {
            "items": {
              "$ref": "#/components/schemas/QuestionDefinition"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Questions"
          },
          "theme_settings": {
            "$ref": "#/components/schemas/ThemeSettings"
          },
          "ending_settings": {
            "$ref": "#/components/schemas/EndingSettings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title"
        ],
        "title": "DraftDefinition"
      },
      "EndingSettings": {
